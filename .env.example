# 開発時は cp .env.example .env で使う。compose.yaml の既定値に合わせてある。
# 本番では Kubernetes の Secret から同じ名前で渡す。

# Rails。本番でのみ必須。開発とテストは tmp/local_secret.txt が使われる。
# SECRET_KEY_BASE=

# PostgreSQL。CloudNativePG の Secret が同じ粒度でキーを分けるため URL にまとめない。
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=postgres

# 本番のみ。開発とテストはデータベース名を config/database.yml で固定している。
# DATABASE_NAME=trpg_catalog
# CACHE_DATABASE_NAME=trpg_catalog_cache
# QUEUE_DATABASE_NAME=trpg_catalog_queue
# CABLE_DATABASE_NAME=trpg_catalog_cable

# MinIO。テスト環境はローカルディスクを使うため参照しない。
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_REGION=us-east-1
S3_BUCKET=trpg-catalog-development
