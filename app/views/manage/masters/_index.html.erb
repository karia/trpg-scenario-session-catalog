<% content_for :title, title %>
<h1 class="font-display text-2xl"><%= title %></h1>

<%= form_with model: record, url: record.persisted? ? record_path.call(record) : index_path,
      class: "mt-6 flex items-end gap-2" do |form| %>
  <div>
    <%= form.label :name, "名前", class: "block text-xs text-muted" %>
    <%= form.text_field :name, class: "mt-1 w-64 border border-rule bg-paper px-3 py-2 text-sm" %>
  </div>
  <%= form.submit record.persisted? ? "更新" : "追加", class: "bg-ink px-5 py-2 text-sm text-paper" %>
  <% if record.persisted? %>
    <%= link_to "やめる", index_path, class: "self-center text-sm text-muted" %>
  <% end %>
<% end %>

<div class="mt-2"><%= accessible_error_summary(record) %></div>

<ul class="mt-6 divide-y divide-rule border border-rule bg-surface text-sm">
  <% records.each do |item| %>
    <li class="flex items-center justify-between p-3">
      <span><%= item.name %></span>
      <span class="flex gap-3 text-xs">
        <%= link_to "詳細", record_path.call(item), class: "text-seal" %>
        <%= link_to "編集", edit_path.call(item), class: "text-seal" %>
        <%= button_to "削除", record_path.call(item), method: :delete, form: { data: { turbo_confirm: "削除しますか" } },
              class: "text-muted" %>
      </span>
    </li>
  <% end %>
</ul>
