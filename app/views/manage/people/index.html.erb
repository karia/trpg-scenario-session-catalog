<% content_for :title, "#{Person.model_name.human}の管理" %>
<h1 class="font-display text-2xl"><%= Person.model_name.human %>の管理</h1>

<%= render "form", person: @person %>

<ul class="mt-8 divide-y divide-rule border border-rule bg-surface text-sm">
  <% @people.each do |item| %>
    <li class="flex items-center justify-between gap-4 p-3">
      <div>
        <p class="font-display"><%= item.display_name %></p>
        <p class="text-xs text-muted">
          権限: <%= person_role_labels(item).join("、") %>
          ／ <%= Group.model_name.human %>: <%= item.groups.map(&:name).join("、").presence || "なし" %>
          ／ <%= User.model_name.human %>: <%= item.users.map { |user| "#{user.provider_name}: #{user.email.presence || user.name.presence || "不明"}" }.join("、").presence || "未紐づけ" %>
        </p>
      </div>
      <span class="flex shrink-0 gap-1 text-xs">
        <%= link_to "詳細", person_path(item), class: "inline-flex min-h-6 items-center px-1 text-seal" %>
        <%= link_to "編集", edit_manage_person_path(item), class: "inline-flex min-h-6 items-center px-1 text-seal" %>
        <%= button_to "削除", manage_person_path(item), method: :delete,
              form: { data: { turbo_confirm: "#{item.display_name} を削除しますか" } },
              class: "min-h-6 px-1 text-muted" %>
      </span>
    </li>
  <% end %>
</ul>
