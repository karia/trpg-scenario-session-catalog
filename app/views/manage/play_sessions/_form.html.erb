<%= form_with model: play_session, class: "mt-8 space-y-8",
      data: { controller: "participation-roles", action: "nested-form:added->participation-roles#update",
              participation_roles_defaults_value: GameSystem::DEFAULT_ROLE_LABELS.to_json,
              participation_roles_labels_value: Scenario.includes(:game_systems).to_h { |scenario|
                [ scenario.id, { gm: scenario.game_master_label, sub_gm: scenario.sub_game_master_label } ]
              }.to_json } do |form| %>
  <%= ui_error_summary(play_session) %>

  <fieldset class="rounded-ui-surface border border-ui-outline bg-ui-surface-solid p-4 sm:p-6">
    <legend class="px-2 font-display text-lg font-bold text-ui-text"><%= PlaySession.model_name.human %></legend>
    <div class="grid gap-5 md:grid-cols-2">
      <div class="md:col-span-2">
        <%= ui_field(form, :scenario_id, label: Scenario.model_name.human, required: true) do |field| %>
          <%= ui_select(form, :scenario_id, Scenario.order(:title).map { |scenario| [ scenario.title, scenario.id ] },
                include_blank: "選択してください", required: true, described_by: field[:described_by],
                data: { participation_roles_target: "scenario", action: "change->participation-roles#update" }) %>
        <% end %>
      </div>
      <% if policy(play_session).update_cocofolia_url? %>
        <%= ui_field(form, :cocofolia_url, label: "ココフォリアリンク") do |field| %>
          <%= ui_input(form, :cocofolia_url, type: :url, placeholder: "https://ccfolia.com/rooms/", described_by: field[:described_by]) %>
        <% end %>
      <% end %>
      <div class="md:col-span-2">
        <%= ui_field(form, :note, label: "メモ") do |field| %><%= ui_textarea(form, :note, rows: 3, described_by: field[:described_by]) %><% end %>
      </div>
    </div>
  </fieldset>

  <%= ui_repeatable_fields form, association: :session_schedules, legend: "日程と録画リンク",
        hint: "未定の開始時刻は空欄にします。", row_partial: "manage/play_sessions/session_schedule_row",
        row_local: :schedule_form, new_record: SessionSchedule.new, add_label: "日程を足す", token: "NEW_SCHEDULE" %>

  <%= ui_repeatable_fields form, association: :participations, legend: "参加者",
        hint: "キャラクター名とキャラシはPLだけ入力します。#{play_session.scenario&.game_master_label || GameSystem::DEFAULT_ROLE_LABELS.fetch(:gm)}と#{play_session.scenario&.sub_game_master_label || GameSystem::DEFAULT_ROLE_LABELS.fetch(:sub_gm)}は空で構いません。",
        row_partial: "manage/play_sessions/participation_row", row_local: :row,
        new_record: Participation.new, add_label: "参加者を足す" %>

  <div class="flex flex-wrap items-center gap-3">
    <%= ui_button play_session.persisted? ? "更新" : "登録", type: "submit" %>
    <%= ui_button_link play_session.persisted? ? "詳細に戻る" : "一覧に戻る",
          href: play_session.persisted? ? play_session_path(play_session) : play_sessions_path, variant: :secondary %>
  </div>
<% end %>
