<fieldset class="rounded-ui-control border border-ui-outline p-4">
  <legend class="px-2 text-sm font-bold text-ui-text">参加者 <%= row.index.to_i + 1 %></legend>
  <div class="grid min-w-0 gap-4 md:grid-cols-2 xl:grid-cols-[minmax(10rem,1fr)_minmax(8rem,0.7fr)_minmax(10rem,1fr)_minmax(14rem,1.3fr)_auto] xl:items-end">
    <%= ui_field(row, :person_id, label: "名前") do |field| %>
      <%= ui_select(row, :person_id, people_for_select.map { |person| [ person.display_name, person.id ] },
            include_blank: "選択してください", described_by: field[:described_by]) %>
    <% end %>
    <%= ui_field(row, :role, label: "役割") do |field| %>
      <%= ui_select(row, :role, Participation.roles.keys.map { |role| [ participation_role_label(row.object, role:), role ] },
            include_blank: "選択してください", described_by: field[:described_by],
            data: { participation_roles_target: "role" }) %>
    <% end %>
    <%= ui_field(row, :character_name, label: "キャラクター名") do |field| %><%= ui_input(row, :character_name, described_by: field[:described_by]) %><% end %>
    <%= ui_field(row, :character_sheet_url, label: "キャラクターシートURL") do |field| %><%= ui_input(row, :character_sheet_url, type: :url, described_by: field[:described_by]) %><% end %>
    <%= ui_checkbox(row, :_destroy, label: "外す") %>
    <%= row.hidden_field :id if row.object.persisted? %>
  </div>
</fieldset>
