<fieldset class="grid min-w-0 gap-4 rounded-ui-control border border-ui-outline p-4 md:grid-cols-[minmax(12rem,1fr)_auto] md:items-end">
  <legend class="sr-only">録画リンク <%= recording_form.index.to_i + 1 %></legend>
  <%= ui_field(recording_form, :url, label: "録画URL", required: true) do |field| %><%= ui_input(recording_form, :url, type: :url, required: true, described_by: field[:described_by]) %><% end %>
  <% if recording_form.object.persisted? %><%= ui_checkbox(recording_form, :_destroy, label: "削除") %><% end %>
</fieldset>
