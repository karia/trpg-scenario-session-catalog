<dialog id="filter-dialog" data-dialog-target="dialog" data-return-focus="filter-button" data-action="click->dialog#closeOnBackdrop" aria-labelledby="filter-title"
        class="mx-0 mt-auto mb-0 max-h-[85dvh] w-full max-w-none rounded-t-ui-sheet border border-b-0 border-ui-outline bg-ui-surface-solid p-0 text-ui-text transition-[translate,opacity,display,overlay] transition-discrete duration-300 ease-out not-open:translate-y-full starting:open:translate-y-full backdrop:bg-black/60 backdrop:transition-[background-color,display,overlay] backdrop:transition-discrete backdrop:duration-300 not-open:backdrop:bg-transparent starting:open:backdrop:bg-transparent motion-reduce:transition-none motion-reduce:backdrop:transition-none sm:m-auto sm:max-w-lg sm:rounded-ui-sheet sm:border-b sm:not-open:translate-y-0 sm:not-open:opacity-0 sm:starting:open:translate-y-0 sm:starting:open:opacity-0">
  <%= form_with url: root_path, method: :get, class: "flex max-h-[85dvh] flex-col", data: { controller: "blank-params", action: "formdata->blank-params#strip" } do |form| %>
    <% @listing.params.slice(:view, :order).each do |key, value| %><%= hidden_field_tag key, value, id: nil %><% end %>
    <div data-sheet-handle class="touch-none border-b border-ui-outline sm:touch-auto" data-action="touchstart->dialog#dragStart touchmove->dialog#drag touchend->dialog#dragEnd touchcancel->dialog#dragEnd">
      <div aria-hidden="true" data-sheet-grabber class="mx-auto mt-2 h-1 w-10 rounded-full bg-ui-outline-strong sm:hidden"></div>
      <div class="flex items-center justify-between py-1 pr-2 pl-4">
        <%= tag.h2 "絞り込み", id: "filter-title", tabindex: -1, data: { dialog_target: "initialFocus" }, class: "font-display text-ui-heading font-bold focus:outline-none" %>
        <button type="button" data-action="dialog#close" aria-label="閉じる" class="inline-flex size-11 cursor-pointer items-center justify-center rounded-ui-control text-ui-heading text-ui-text-muted hover:bg-ui-subtle">×</button>
      </div>
    </div>
    <div class="space-y-6 overflow-y-auto px-4 py-5">
      <fieldset>
        <legend class="font-display text-ui-title font-bold">人数</legend>
        <div class="mt-2 flex flex-wrap gap-x-2">
          <%= ui_radio "player_count", "", label: "指定なし", checked: @listing.player_count.nil?, id: "player_count_any" %>
          <% player_count_filter_options.each do |count, label| %><%= ui_radio "player_count", count, label:, checked: @listing.player_count == count, id: "player_count_#{count}" %><% end %>
        </div>
      </fieldset>
      <fieldset>
        <legend class="font-display text-ui-title font-bold"><%= GameSystem.model_name.human %></legend>
        <div class="mt-2 flex flex-wrap gap-x-2"><%= ui_collection_checkboxes form, :game_system_ids, @listing.game_system_options, value_method: :id, text_method: :name, checked: @listing.game_systems.map(&:id), include_hidden: false %></div>
      </fieldset>
      <fieldset>
        <legend class="font-display text-ui-title font-bold"><%= Author.model_name.human %></legend>
        <% if @listing.authors.any? %><div class="mt-2 flex flex-wrap gap-x-2"><%= ui_collection_checkboxes form, :author_ids, @listing.authors, value_method: :id, text_method: :name, checked: @listing.authors.map(&:id), include_hidden: false %></div><% end %>
        <label class="mt-3 block font-bold" for="author_name"><%= Author.model_name.human %>を追加</label>
        <%= text_field_tag :author_name, (@listing.author_name if @listing.author_name_error?), list: "author-suggestions", autocomplete: "off", autofocus: @listing.author_name_error?, placeholder: "#{Author.model_name.human}名を入力", aria: { describedby: "author-help#{' author-error' if @listing.author_name_error?}", invalid: ("true" if @listing.author_name_error?) }, class: "mt-2 min-h-11 w-full rounded-ui-control border border-ui-outline-strong bg-ui-field-solid px-3 py-2 text-ui-input text-ui-text placeholder:text-ui-text-muted aria-invalid:border-ui-error" %>
        <datalist id="author-suggestions"><% @listing.author_suggestions.each do |name| %><option value="<%= name %>"></option><% end %></datalist>
        <p id="author-help" class="mt-2 text-ui-caption text-ui-text-muted">候補から選択します。<%= Author.model_name.human %>は複数選択できます。</p>
        <% if @listing.author_name_error? %><p id="author-error" role="alert" class="mt-1 text-ui-caption text-ui-error">候補から<%= Author.model_name.human %>を選択してください。</p><% end %>
      </fieldset>
    </div>
    <div class="flex justify-end gap-2 border-t border-ui-outline px-4 py-3">
      <%= ui_button_link("すべて解除", href: root_path(@listing.params(author_ids: nil, game_system_ids: nil, player_count: nil)), variant: :secondary) %>
      <%= ui_button("適用する", type: "submit") %>
    </div>
  <% end %>
</dialog>
