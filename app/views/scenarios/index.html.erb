<% list_title = @owner ? "#{@owner.display_name}が所持するTRPG#{Scenario.model_name.human}一覧" : "#{Scenario.model_name.human}一覧" %>
<% content_for :title, list_title %>
<% chips = scenario_filter_chips(@listing) %>

<%= turbo_frame_tag "scenario_list", data: { turbo_action: "advance", controller: "frame-focus", action: "turbo:before-fetch-request->frame-focus#remember turbo:frame-render->frame-focus#restore" } do %>
  <div class="space-y-4" data-controller="dialog" data-dialog-open-value="<%= @listing.author_name_error? %>">
    <div class="flex flex-wrap items-center justify-between gap-x-4 gap-y-2">
      <%= render "shared/ui/page_header", title: "#{Scenario.model_name.human}一覧" %>
      <div class="flex items-center gap-2">
        <% if policy(Scenario).create? %><%= ui_button_link("新規登録", href: new_scenario_path, size: :small, data: { turbo_frame: "_top" }) %><% end %>
        <nav class="flex rounded-ui-control border border-ui-outline-strong bg-ui-field-solid p-0.5" aria-label="表示の切り替え">
          <% [ [ "table", "表形式" ], [ "gallery", "ジャケット" ] ].each do |view, label| %>
            <%= link_to root_path(@listing.params(view:)), title: label, aria: { label:, current: ("page" if @listing.view == view) },
                  class: "inline-flex size-11 items-center justify-center rounded-[0.65rem] #{@listing.view == view ? 'bg-ui-action text-ui-on-action' : 'text-ui-text hover:bg-ui-subtle'}" do %>
              <% if view == "table" %>
                <svg aria-hidden="true" viewBox="0 0 24 24" class="size-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M8 6h13M8 12h13M8 18h13M3 6h.01M3 12h.01M3 18h.01" /></svg>
              <% else %>
                <svg aria-hidden="true" viewBox="0 0 24 24" class="size-5" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="7" height="7" rx="1" /><rect x="14" y="3" width="7" height="7" rx="1" /><rect x="3" y="14" width="7" height="7" rx="1" /><rect x="14" y="14" width="7" height="7" rx="1" /></svg>
              <% end %>
            <% end %>
          <% end %>
        </nav>
      </div>
    </div>
    <p class="text-ui-caption text-ui-text-muted" role="status"><%= "#{@owner.display_name}が所持する" if @owner %>全<%= @scenarios.size %>件</p>

    <div class="flex gap-2">
      <%= ui_button("絞り込み#{"（#{chips.size}）" if chips.any?}", variant: :secondary, id: "filter-button", data: { action: "dialog#open" }, aria: { haspopup: "dialog" }) %>
      <%= form_with url: root_path, method: :get, class: "flex min-w-0 flex-1 gap-2 sm:max-w-xs", data: { controller: "auto-submit" } do %>
        <% @listing.params(order: nil).each do |key, value| %><% Array(value).each do |item| %><%= hidden_field_tag key.to_s.end_with?("_ids") ? "#{key}[]" : key, item, id: nil %><% end %><% end %>
        <%= label_tag :order, "並び順", class: "sr-only" %><%= select_tag :order, scenario_order_options(@listing), data: { action: "change->auto-submit#submit" }, class: "min-h-11 w-full min-w-0 rounded-ui-control border border-ui-outline-strong bg-ui-field-solid px-3 py-2 text-ui-input text-ui-text" %>
        <noscript class="shrink-0"><%= ui_button("並べ替える", size: :small, type: "submit") %></noscript>
      <% end %>
    </div>

    <% if chips.any? %>
      <ul class="flex flex-wrap gap-2" aria-label="適用中の条件" data-return-focus="filter-button">
        <% chips.each do |label, params| %>
          <li class="inline-flex min-h-11 items-center rounded-full border border-ui-outline-strong bg-ui-subtle pl-3"><%= label %><%= link_to "×", root_path(params), aria: { label: "#{label}を解除" }, class: "inline-flex min-h-11 min-w-11 items-center justify-center text-ui-action no-underline" %></li>
        <% end %>
      </ul>
    <% end %>

    <noscript><style nonce="<%= content_security_policy_nonce %>">#filter-dialog{display:block;position:static;margin:0;max-height:none;border-radius:var(--radius-ui-surface)}#filter-dialog>form{max-height:none}#filter-button,#filter-dialog [data-action="dialog#close"]{display:none}</style></noscript>
    <%= render "scenarios/filter_dialog" %>

    <% if @scenarios.any? %>
      <%= render "scenarios/#{@listing.view}", scenarios: @scenarios %>
    <% else %>
      <%= render "shared/ui/empty_state", title: (@listing.filtered? ? "条件に合う#{Scenario.model_name.human}がありません。" : "まだ#{Scenario.model_name.human}が登録されていません。") %>
    <% end %>
  </div>
<% end %>
