<fieldset class="grid gap-2 border border-rule p-3 sm:grid-cols-[minmax(0,1fr)_auto_auto]" data-nested-form-target="aliasRow">
  <legend class="px-1 text-sm font-bold">別名 <%= row.index.to_i + 1 %></legend>
  <% selection_key = row.object.selection_key.presence || row.object.id || row.index %>
  <div><%= row.label :name, "名前", class: "block text-xs text-muted" %>
  <%= row.text_field :name, class: "mt-1 w-full border border-rule bg-paper px-3 py-2 text-sm",
        data: { alias_name: true, selection_key: selection_key } %></div>
  <label class="inline-flex items-center gap-1 text-xs text-muted">
    <%= row.check_box :visible, data: { alias_visible: true } %> 表示
  </label>
  <label class="inline-flex items-center gap-1 text-xs text-muted">
    <%= row.check_box :_destroy, data: { alias_destroy: true } %> 削除
  </label>
  <%= row.hidden_field :id if row.object.persisted? %>
  <%= row.hidden_field :selection_key, value: selection_key %>
  <% if row.object.respond_to?(:context) %>
    <div class="sm:col-start-1"><%= row.label :context, "使用場所", class: "block text-xs text-muted" %>
    <%= row.text_field :context, class: "mt-1 w-full border border-rule bg-paper px-3 py-2 text-sm" %></div>
  <% end %>
</fieldset>
