<% classes = "inline-flex min-h-11 items-center justify-center gap-2 rounded-ui-control border py-2 text-sm font-bold no-underline transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ui-focus focus-visible:ring-offset-2 focus-visible:ring-offset-ui-background disabled:cursor-not-allowed disabled:opacity-50 #{variant_classes} #{size_classes}" %>
<% if href %>
  <%= tag.a label, href:, data:, aria:, class: classes %>
<% else %>
  <%= tag.button label, type:, disabled:, id:, data:, aria:, class: classes %>
<% end %>
