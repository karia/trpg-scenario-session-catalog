{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "github>karia/renovate-config"
  ],
  "dependencyDashboard": {
    "enabled": true
  },
  "pinDigests": true,
  "automerge": false,
  "packageRules": [
    {
      "description": "Keep every Ruby version reference on the same version",
      "matchDepNames": [
        "ruby",
        "docker.io/library/ruby"
      ],
      "groupName": "Ruby"
    }
  ]
}
